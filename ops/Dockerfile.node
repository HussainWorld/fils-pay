# Added: this file was referenced by docker-compose.yml but never committed.
# Image for api, reporting, migrate and seed. Build context is the repo root
# (see docker-compose.yml). Full install, including devDependencies, because
# the services run TypeScript directly through tsx.
#
# node:22 (the repo needs >=22, e.g. cookie@2) on the slim Debian base, plus
# the toolchain node-gyp needs: argon2 compiles from source on platforms
# without a prebuilt binary (e.g. linux/arm64 on Apple Silicon). Smaller
# than the full node image, which matters on the 2 GB hosted disk.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .
RUN npm ci

EXPOSE 3000
