# FIX D-1: docker-compose.yml built this file but it was never committed.
# Image for apps/api, apps/reporting and the one-off migrate/seed jobs.
# Runs TypeScript directly with tsx, same as local dev.
#
# -slim rather than the full image keeps it inside the box's 2 GB disk;
# argon2 and sharp ship glibc prebuilds, so no compiler toolchain is needed.
# FIX D-10: node:22, not 20 — cookie@2.0.1 (via @fastify/cookie) requires >=22, and Node 20's test
# runner can't expand "src/**/*.test.ts", so npm test silently ran zero api/reporting/web tests.
FROM node:22-slim

WORKDIR /app

# Manifests first so the dependency layer is cached across source changes.
# Every workspace manifest is copied because npm ci checks the lockfile
# against all of them, even when installing a subset.
COPY package.json package-lock.json tsconfig.json tsconfig.base.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/

# Only the backend workspaces (plus root, which carries tsx and pg for
# db/ and scripts/) — the React apps are built in Dockerfile.web.
RUN npm ci --no-audit --no-fund \
      --include-workspace-root \
      --workspace=@filspay/money \
      --workspace=@filspay/events \
      --workspace=@filspay/api \
      --workspace=@filspay/reporting \
  && npm cache clean --force

COPY packages packages
COPY apps/api apps/api
COPY apps/reporting apps/reporting
COPY db db
COPY scripts scripts

# KYC uploads land in ./data/kyc (KYC_UPLOAD_DIR default); compose mounts a
# volume here.
RUN mkdir -p /app/data/kyc && chown -R node:node /app/data
USER node

EXPOSE 3000
CMD ["npx", "tsx", "apps/api/src/index.ts"]
