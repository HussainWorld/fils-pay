# Copy to ops/.env.prod (git-ignored) and fill in: cp ops/prod.env.example ops/.env.prod Generate secrets with:
#   openssl rand -hex 24          (passwords / tokens)
#   openssl rand -base64 32       (WEBHOOK_SECRET_ENCRYPTION_KEY, must be 32 bytes)
POSTGRES_PASSWORD=
SETTLEMENT_INTERNAL_TOKEN=
WEBHOOK_SECRET_ENCRYPTION_KEY=
# From the acquirer. Do NOT reuse the value committed in ops/.env.docker: it is
# in git history and must be treated as leaked (rotate it with the acquirer).
ACQUIRER_CALLBACK_SIGNING_SECRET=
# true when served over HTTPS (recommended); false only for a plain-http demo
COOKIE_SECURE=true
# true ONLY for a local run / demo: shows the login OTP on screen (no email sender exists yet)
OTP_DEV_EXPOSE=false
