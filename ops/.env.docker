# Shared, non-secret service settings, loaded into the api via `env_file:`
# in docker-compose.yml. Secrets (DB password, internal token, webhook
# encryption key, acquirer callback secret) live in ops/.env, which is
# gitignored and generated by ops/gen-env.sh — never in this file, which is
# committed.
#
# NODE_ENV=production so local behaviour matches the hosted box (https-only
# webhook URLs, required secrets, no OTP exposed in responses). Cookie
# Secure is controlled separately by COOKIE_SECURE in ops/.env.
NODE_ENV=production
PORT=3000
# FIX D-3: ACQUIRER_CALLBACK_SIGNING_SECRET used to be committed here (the comment claimed this file
# was gitignored; the `.env` pattern only matches that exact name). It now comes from ops/.env.
# The old value is in git history: treat it as leaked.
