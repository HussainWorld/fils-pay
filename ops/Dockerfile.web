# Builds apps/web (merchant dashboard + hosted checkout) and apps/admin (ops
# console) and serves both from nginx, which also reverse-proxies /v1 to
# apps/api. Everything is one origin: apps/api has no CORS handling and both
# frontends authenticate with cookies, so cross-origin hosting can't work.
#
#   /          apps/web
#   /admin/    apps/admin
#   /v1/*      apps/api
FROM node:22-slim AS build

WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.base.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/

RUN npm ci --no-audit --no-fund \
      --include-workspace-root \
      --workspace=@filspay/money \
      --workspace=@filspay/web \
      --workspace=@filspay/admin

COPY packages packages
COPY apps/web apps/web
COPY apps/admin apps/admin

# FIX D-9: the clients default to http://localhost:3000 (cross-origin, and the api has no CORS).
# Empty base URLs make both call relative paths (/v1/...), i.e. the same
# origin nginx serves them from. The clients use `??`, so "" is kept.
ENV VITE_API_BASE_URL="" \
    VITE_ADMIN_API_BASE_URL="" \
    VITE_WEB_BASE_URL=""
RUN npm run build --workspace=@filspay/web \
 && npm run build --workspace=@filspay/admin -- --base=/admin/

FROM nginx:1.27-alpine
COPY ops/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html/admin
EXPOSE 80
