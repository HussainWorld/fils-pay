# Builds the merchant dashboard (apps/web) and the admin console (apps/admin)
# and serves both with nginx, which also proxies /v1 to the api container, so
# the browser talks to one origin (the API has no CORS, by design).
FROM node:22-bookworm-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN npm ci
# empty = same origin (relative /v1/... URLs through the nginx proxy)
ENV VITE_API_BASE_URL="" VITE_ADMIN_API_BASE_URL=""
RUN npm run build -w @filspay/web && npm run build -w @filspay/admin

FROM nginx:1.27-alpine
COPY ops/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/web
COPY --from=build /app/apps/admin/dist /usr/share/nginx/admin
